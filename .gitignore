```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Python artifacts (if any Python in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Compiled binaries
*.exe
*.dll
*.so
*.dylib

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z
```