```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.tsbuildinfo

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
*.tar.gz
*.whl
*.egg-info/

# OS generated files
.DS_Store
Thumbs.db
```